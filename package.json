{
  "name": "blockr.outline",
  "private": true,
  "description": "JS bundle for the blockr.outline Milkdown markdown editor (built into inst/js).",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@milkdown/kit": "7.21.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "scripts": {
    "build": "npx esbuild srcjs/md-editor/index.js --bundle --outfile=inst/js/md-editor.js --format=iife --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:meta": "npm run build -- --metafile=tools/meta.json",
    "licenses": "node tools/licenses.js tools/meta.json"
  }
}
